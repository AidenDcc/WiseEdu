node_modules/
dist/
# 构建产物的旁路目录（如某些预览/沙箱工具生成的 dist-<时间戳>）
# 正常构建只写 dist/，这一条只用于兜住游离的外加目录
dist-*/
*.local
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/
coverage/
*.tsbuildinfo
doc/_build/*
# Office 临时锁文件
~$*
.~*

# ===== Java / Maven 后端（由原 Service/.gitignore 合并）=====
**/target
**/logs
*.iml
*.iws
*.ipr
out/
rebel.xml
derby.log
**/.classpath
**/.project
**/.settings/
