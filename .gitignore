node_modules/
dist/
# 构建产物的旁路目录（如某些预览/沙箱工具生成的 dist-<时间戳>）
# 正常构建只写 dist/，这一条只用于兜住游离的外加目录
dist-*/
*.local
# 阿里云 OSS 凭据（见 config/oss.env.example）；只提交示例，不提交真实密钥。
# 注意：不要在这里加 .env / .env.* —— 前端的 apps/*/.env.development 是要进版本库的
config/oss.env
# JeecgBoot 启动时 CodeTemplateInitListener 会把 classpath 里的代码生成模板
# 复制到 user.dir/config/jeecg/ 下（内容与 jeecg-system-biz/src/main/resources
# 里已跟踪的模板逐字节相同）。在哪个目录启动 jar 就在哪里生成一份，纯运行期产物。
# 注意只忽略 config/jeecg/，不能整个忽略 config/ —— 同目录下的 oss.env.example 要进库。
**/config/jeecg/
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/
coverage/
*.tsbuildinfo
doc/_build/*
# 数据库基线的一次性备份快照（本地演示数据，可随时重新导出）
doc/schema.sql.bak
# Python 本地脚本产物（db/ 下的迁移/种子脚本）
db/__pycache__/
*.pyc
# db/backup/ 是 20261021 单库合并时的一次性回滚快照（含本地演示数据），
# 需要时用 mysqldump 重新导出即可，不作为工程资产入库。
db/backup/
# Office 临时锁文件
~$*
.~*

# ===== Java / Maven 后端（由原 Service/.gitignore 合并）=====
**/target
**/logs
*.iml
*.iws
*.ipr
out/
rebel.xml
derby.log
**/.classpath
**/.project
**/.settings/
