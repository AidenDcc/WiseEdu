# ============================================================================
# 阿里云 OSS 凭据（教学云：所有物理文件统一落 aiden-dcc 桶）
#
# 用法（任选其一）：
#   A. 手动导出：
#        set -a; source config/oss.env; set +a
#        ./scripts/start-dev.command
#   B. 直接写进 shell 的 ~/.zshrc
#
# 约定：**不要把真实凭据写进任何会被提交的文件**。
#       config/oss.env 已在 .gitignore 中忽略；本文件（.example）只放占位值。
#
# 最小权限（建议用 RAM 子账号，不要用主账号 AK）：
#   oss:PutObject / oss:GetObject / oss:DeleteObject / oss:HeadObject
#   Resource: acs:oss:cn-guangzhou:*:<bucket>/*
# ============================================================================

# 必填
export EDU_OSS_ACCESS_KEY=
export EDU_OSS_SECRET_KEY=

# 选填（默认值即下面这套，对应华南3·广州 aiden-dcc）
export EDU_OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
export EDU_OSS_BUCKET=aiden-dcc
export EDU_OSS_ENABLED=true

# 桶内业务根目录：对象 Key 形如 edu/avatar/2026/10/21/<uuid>.png
export EDU_OSS_KEY_PREFIX=edu

# 代理地址前缀：开发态前端 Vite 把 /api 转发到 9999；nginx 直连时可留空
export EDU_OSS_PROXY_BASE=/api

# 代理地址签名密钥（HMAC-SHA256）。生产务必改成随机串，且与旧值不同即意味着
# 库里存量地址全部失效（地址里带 sign），换之前请评估
export EDU_OSS_SIGN_SECRET=

# 单文件上限（MB）。需与 spring.servlet.multipart.max-file-size 同步
export EDU_OSS_MAX_SIZE_MB=200
