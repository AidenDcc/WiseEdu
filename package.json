{
  "//": "启动全部两个前端应用（并行）: pnpm dev；或只启动某一个: pnpm dev:admin(超管端→http://localhost:5173/) / pnpm dev:tenant(机构端→http://localhost:5174/)。后端服务位于 Service/ 目录。",
  "name": "ai-teaching-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "AI教学云平台（SaaS多租户）：超级管理端 + 机构端前端，后端位于 Service/",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @aiteach/admin --filter @aiteach/tenant dev",
    "dev:admin": "pnpm --filter @aiteach/admin dev",
    "dev:tenant": "pnpm --filter @aiteach/tenant dev",
    "build": "pnpm -r build",
    "build:admin": "pnpm --filter @aiteach/admin build",
    "build:tenant": "pnpm --filter @aiteach/tenant build",
    "typecheck": "pnpm -r typecheck",
    "hash-password": "node scripts/hash-password.mjs",
    "preview:admin": "pnpm --filter @aiteach/admin preview",
    "preview:tenant": "pnpm --filter @aiteach/tenant preview"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "canvas"
    ]
  }
}
