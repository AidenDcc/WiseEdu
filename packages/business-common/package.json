{
  "name": "@aiteach/business-common",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "题库 / 试卷 / 组卷三块业务的**共用层**：两端不变的 UI 组件、TS 类型、基础接口契约与通用筛选面板。\n组件只渲染骨架（props + extraFilter / renderOperation 插槽），不写 admin/tenant 分支、不碰租户权限与 tenant_id 过滤 —— 那些留在 apps 各自页面。\n基础接口以 BusinessApi 契约注入（见 src/api/business-api.ts），组件不 import 任何 apps 目录。",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./api": "./src/api/business-api.ts",
    "./compose/*": "./src/compose/*.ts",
    "./composables/*": "./src/composables/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./components/*": "./src/components/*"
  },
  "dependencies": {
    "@aiteach/shared": "workspace:*",
    "@element-plus/icons-vue": "^2.3.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit"
  }
}
